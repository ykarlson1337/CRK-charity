---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  eyebrow: string;
  title: string;
  lede: string;
  image?: ImageMetadata;
  imageAlt?: string;
}

const { eyebrow, title, lede, image, imageAlt = '' } = Astro.props;
---

<section class:list={['page-hero', 't-skov', { 'has-image': image }]} aria-labelledby="page-title">
  {
    image && (
      <div class="media">
        <Picture
          src={image}
          formats={['avif', 'webp']}
          widths={[640, 960, 1280, 1678]}
          sizes="100vw"
          alt={imageAlt}
          loading="eager"
          fetchpriority="high"
          class="media-img"
        />
        <div class="shade" aria-hidden="true" />
      </div>
    )
  }
  <div class="wrap inner">
    <div class="copy">
      <p class="eyebrow">{eyebrow}</p>
      <h1 id="page-title" class="disp h1">{title}</h1>
      <p class="lede">{lede}</p>
      <slot />
    </div>
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
  }

  .media {
    position: absolute;
    inset: 0;
  }

  /* <Picture> wraps the img; give the wrapper the box so object-fit covers it. */
  .media :global(picture) {
    height: 100%;
  }

  .media :global(.media-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      var(--forest-950) 0%,
      var(--forest-950) 40%,
      rgba(14, 42, 32, 0.6) 64%,
      rgba(14, 42, 32, 0.15) 100%
    );
  }

  .inner {
    position: relative;
    padding-block: clamp(72px, 8vw, 112px) clamp(80px, 8.5vw, 120px);
  }

  .copy {
    max-width: 680px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .copy .eyebrow {
    margin: 0;
  }

  .h1 {
    font-size: clamp(46px, 6vw, 80px);
    line-height: 1.04;
  }

  .lede {
    max-width: 600px;
    color: var(--cream);
  }

  @media (max-width: 760px) {
    .page-hero.has-image {
      display: flex;
      flex-direction: column;
    }

    .media {
      position: relative;
      order: 2;
      height: 220px;
    }

    .shade {
      background: linear-gradient(180deg, var(--forest-950) 0%, rgba(14, 42, 32, 0) 45%);
    }

    .inner {
      order: 1;
      padding-block: 44px 36px;
    }

    .has-image .inner {
      padding-bottom: 28px;
    }

    .copy {
      gap: 16px;
    }

    .h1 {
      font-size: clamp(40px, 11vw, 52px);
    }
  }
</style>
