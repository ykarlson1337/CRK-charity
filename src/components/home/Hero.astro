---
import { Picture } from 'astro:assets';
import heroPhoto from '../../assets/photos/golfbane-smorum.jpg';
import { event, flags } from '../../data/event';
---

<section class="hero t-skov" aria-labelledby="hero-title">
  <div class="hero-media">
    <Picture
      src={heroPhoto}
      formats={['avif', 'webp']}
      widths={[640, 960, 1280, 1678]}
      sizes="100vw"
      alt="Fairway på Smørum Golfklub med to golfspillere på vej mod green"
      loading="eager"
      fetchpriority="high"
      class="hero-img"
    />
    <div class="hero-shade" aria-hidden="true"></div>
  </div>
  <div class="wrap hero-inner">
    <div class="hero-copy">
      <p class="eyebrow">{event.club} præsenterer</p>
      <div class="title-group">
        <h1 id="hero-title" class="disp h1">Charity Golf {event.year}</h1>
        {flags.titelsponsorSolgt && <p class="small presented">Præsenteret af {event.titleSponsor}</p>}
        <p class="tagline">Golf · Galla · Auktion</p>
      </div>
      <ul class="facts">
        <li>{event.dateLabel}</li>
        <li>{event.venue}</li>
        <li>Gallamiddag på {event.dinnerVenue}</li>
      </ul>
      <p class="body">
        Holdturnering på 18 huller, par 3 for nybegyndere og gallamiddag med auktion. Overskuddet går til det gode
        formål.
      </p>
      <div class="actions">
        <a class="btn btn-gold btn-block-mobile" href="#kontakt">Book jeres plads</a>
        <a class="btn btn-ghost btn-block-mobile" href="/sponsor">Se sponsorpakker</a>
      </div>
      <p class="small deadline">Tilmelding senest {event.deadlineLabel}. Først til mølle.</p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
  }

  .hero-media {
    position: absolute;
    inset: 0;
  }

  /* <Picture> wraps the img; give the wrapper the box so object-fit covers it. */
  .hero-media :global(picture) {
    height: 100%;
  }

  .hero-media :global(.hero-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      var(--forest-950) 0%,
      var(--forest-950) 34%,
      rgba(14, 42, 32, 0.62) 58%,
      rgba(14, 42, 32, 0.12) 100%
    );
  }

  .hero-inner {
    position: relative;
    padding-block: clamp(96px, 10vw, 136px) clamp(104px, 11vw, 152px);
  }

  .hero-copy {
    max-width: 780px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .hero-copy .eyebrow {
    margin: 0;
  }

  .title-group {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .presented {
    font-size: 15px;
    color: var(--mist);
  }

  .facts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    font-size: 18px;
    color: var(--cream);
  }

  .facts li + li::before {
    content: '·';
    padding: 0 0.45em;
  }

  .hero-copy > .body {
    max-width: 600px;
  }

  @media (max-width: 1100px) {
    .facts {
      flex-direction: column;
      gap: 4px;
    }

    .facts li + li::before {
      content: none;
    }
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }

  @media (max-width: 760px) {
    .hero-media {
      position: relative;
      height: 240px;
      order: 2;
    }

    .hero {
      display: flex;
      flex-direction: column;
    }

    .hero-inner {
      order: 1;
      padding-block: 44px 28px;
    }

    .hero-shade {
      background: linear-gradient(180deg, var(--forest-950) 0%, rgba(14, 42, 32, 0) 40%);
    }

    .hero-copy {
      gap: 18px;
    }

    .facts {
      flex-direction: column;
      font-size: 17px;
    }

    .facts li + li::before {
      content: none;
    }

    .actions {
      flex-direction: column;
    }

    .deadline {
      text-align: center;
    }
  }
</style>
