---
import { Picture } from 'astro:assets';
import HistoryTimeline from '../motion/HistoryTimeline';
import NumberTicker from '../motion/NumberTicker';
import handover from '../../assets/photos/overraekkelse-2026.jpeg';
import { handoverCaption, history, totals } from '../../data/event';

// Chronological, so the story reads from the first tournament to the next one.
const years = [...history].reverse();
---

<section id="historie" class="t-creme sec" aria-labelledby="historie-title">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow">Historien</p>
      <h2 id="historie-title" class="disp h2">Udsolgt hvert år siden 2024</h2>
    </div>

    <HistoryTimeline client:visible={{ rootMargin: '400px' }} years={years}>
      <figure slot="photo">
        <Picture
          src={handover}
          formats={['avif', 'webp']}
          widths={[480, 720, 1040]}
          sizes="(max-width: 760px) 100vw, 520px"
          alt="Overrækkelse af checken til Legeheltene den 13. maj 2026"
          class="photo"
        />
        <figcaption class="small">{handoverCaption}</figcaption>
      </figure>
    </HistoryTimeline>

    <p class="body total">
      I alt <span class="num amount-total"><NumberTicker client:visible={{ rootMargin: '400px' }} value={totals.donatedKr} /> kr.</span> til
      velgørenhed siden 2024 [plus 2026-beløbet].
    </p>
  </div>
</section>

<style>
  .total {
    margin-top: clamp(32px, 4vw, 48px);
    padding-top: 24px;
    border-top: 1px solid var(--line-cream);
  }

  .amount-total {
    font-size: 28px;
  }

  @media (max-width: 760px) {
    .amount-total {
      font-size: 26px;
    }
  }
</style>
