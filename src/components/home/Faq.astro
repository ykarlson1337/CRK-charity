---
import { faq } from '../../data/event';
---

<section class="t-creme faq-section" aria-labelledby="faq-title">
  <div class="wrap sec layout">
    <div class="intro">
      <p class="eyebrow">Før I booker</p>
      <h2 id="faq-title" class="disp h2">Spørgsmål og svar</h2>
      <p class="small more">Finder I ikke svaret? Ring til en af os. Numrene står nederst på siden.</p>
    </div>
    <div class="faq">
      {
        faq.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-section {
    border-top: 1px solid var(--line-cream);
  }

  .layout {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(28px, 5vw, 72px);
    align-items: flex-start;
  }

  .intro {
    flex: 1 1 340px;
  }

  .more {
    margin-top: 16px;
    font-size: 15px;
  }

  .faq {
    flex: 999 1 560px;
    min-width: 0;
  }

  details {
    border-bottom: 1px solid var(--border);
  }

  details:first-child {
    border-top: 1px solid var(--border);
  }

  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 20px 0;
    list-style: none;
    cursor: pointer;
    font: 600 18px/1.4 var(--font-sans);
    color: var(--ink);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '+';
    flex: none;
    font: 400 30px/1 var(--font-display);
    color: var(--accent);
  }

  details[open] summary::after {
    content: '\2212';
  }

  details p {
    max-width: 640px;
    margin: 0 0 22px;
    color: var(--ink-body);
  }

  @media (max-width: 760px) {
    .more {
      display: none;
    }

    summary {
      gap: 16px;
      padding: 18px 0;
      font-size: 17px;
    }
  }
</style>
