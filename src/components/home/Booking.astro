---
import ContactList from '../ContactList.astro';
import { bookingOptions, event } from '../../data/event';
---

<section id="kontakt" class="t-skov sec" aria-labelledby="kontakt-title">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow">Tilmelding</p>
      <h2 id="kontakt-title" class="disp h2">Book jeres plads</h2>
      <p class="lede intro">
        Udfyld formularen, så vender vi tilbage med bekræftelse og faktura inden for {event.replyDays} hverdage. Tilmelding
        senest {event.deadlineLabel}. Pladserne går efter først til mølle.
      </p>
    </div>
    <div class="layout">
      <form class="t-creme booking" action="/api/booking" method="post" aria-label="Booking-forespørgsel" data-booking>
        <p class="form-error full" role="alert" hidden data-form-error></p>
        <p class="small full">Felter med * skal udfyldes.</p>
        <div class="field">
          <label for="f-navn">Navn *</label>
          <input id="f-navn" class="input" type="text" name="navn" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="f-firma">Virksomhed</label>
          <input id="f-firma" class="input" type="text" name="virksomhed" autocomplete="organization" />
        </div>
        <div class="field">
          <label for="f-mail">E-mail *</label>
          <input id="f-mail" class="input" type="email" name="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="f-tlf">Telefon *</label>
          <input id="f-tlf" class="input" type="tel" name="telefon" autocomplete="tel" required />
        </div>
        <div class="field">
          <label for="f-pakke">Pakke *</label>
          <select id="f-pakke" class="input" name="pakke" required>
            <option value="">Vælg pakke</option>
            {bookingOptions.map((o) => <option value={o.value}>{o.label}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="f-antal">Antal</label>
          <input id="f-antal" class="input" type="number" name="antal" min="1" inputmode="numeric" />
        </div>
        <div class="field full">
          <label for="f-besked">Besked</label>
          <textarea id="f-besked" class="input" name="besked" rows="4"></textarea>
        </div>
        <div class="hp" aria-hidden="true">
          <label for="f-website">Lad dette felt være tomt</label>
          <input id="f-website" type="text" name="website" tabindex="-1" autocomplete="off" />
        </div>
        <p class="small full">
          Vi bruger jeres oplysninger til at behandle tilmeldingen. Læs vores <a class="link" href="/privatliv">privatlivspolitik</a>.
        </p>
        <div class="full">
          <button class="btn btn-forest btn-block" type="submit">Send forespørgsel</button>
        </div>
      </form>

      <aside class="aside">
        <h3 class="disp h3">Vil I hellere ringe?</h3>
        <ContactList />
        <div class="extra">
          <a class="btn btn-ghost btn-block-mobile" href={event.prospectUrl} download>Hent sponsorprospektet (PDF)</a>
          <p class="small">Tilmeldingsfrist: {event.deadlineLabel}.</p>
        </div>
      </aside>
    </div>
  </div>
</section>

<script>
  // Show the error the booking endpoint sent us back with (?fejl=...).
  const errors: Record<string, string> = {
    felter: 'Udfyld navn, e-mail, telefon og pakke, og prøv igen.',
    send: 'Vi kunne ikke sende jeres forespørgsel lige nu. Prøv igen senere, eller ring til en af os.',
  };
  const errorBox = document.querySelector<HTMLElement>('[data-form-error]');
  const errorCode = new URLSearchParams(window.location.search).get('fejl');
  if (errorBox && errorCode && errors[errorCode]) {
    errorBox.textContent = errors[errorCode];
    errorBox.hidden = false;
  }

  // Preselect the package when a package button is used, on this page or
  // via /?pakke=<id>#kontakt from another page.
  const select = document.querySelector<HTMLSelectElement>('#f-pakke');
  const choose = (value: string | null) => {
    if (!select || !value) return;
    if ([...select.options].some((o) => o.value === value)) select.value = value;
  };
  choose(new URLSearchParams(window.location.search).get('pakke'));
  document.querySelectorAll<HTMLElement>('[data-package]').forEach((el) => {
    el.addEventListener('click', () => choose(el.dataset.package ?? null));
  });
</script>

<style>
  .intro {
    margin-top: 20px;
  }

  .layout {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(32px, 5vw, 64px);
    align-items: flex-start;
  }

  .booking {
    flex: 999 1 560px;
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 20px;
    padding: clamp(24px, 3vw, 40px);
    border-radius: var(--radius-md);
    background: var(--paper);
  }

  .full {
    grid-column: 1 / -1;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  label {
    font: 600 14px/1.3 var(--font-sans);
    color: var(--forest-950);
  }

  .input {
    width: 100%;
    min-height: 48px;
    padding: 12px 14px;
    border: 1px solid var(--slate-muted);
    border-radius: var(--radius-sm);
    background: var(--cream);
    color: var(--forest-950);
    font: 400 16px/1.4 var(--font-sans);
  }

  textarea.input {
    min-height: 112px;
    resize: vertical;
  }

  .form-error {
    margin: 0;
    padding: 12px 16px;
    border-left: 3px solid #a3402c;
    border-radius: var(--radius-sm);
    background: #f6e3dc;
    color: #5c2316;
    font: 500 15px/1.45 var(--font-sans);
  }

  .form-error[hidden] {
    display: none;
  }

  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .aside {
    flex: 1 1 300px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .extra {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding-top: 24px;
    border-top: 1px solid var(--line-forest);
  }

  @media (max-width: 760px) {
    .booking {
      grid-template-columns: 1fr;
      gap: 18px;
      padding: 24px 20px;
    }

    .extra {
      align-items: stretch;
    }
  }
</style>
