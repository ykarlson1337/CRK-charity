---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Stats from '../components/home/Stats.astro';
import Day from '../components/home/Day.astro';
import Program from '../components/home/Program.astro';
import Prices from '../components/home/Prices.astro';
import Purpose from '../components/home/Purpose.astro';
import History from '../components/home/History.astro';
import Auction from '../components/home/Auction.astro';
import Sponsors from '../components/home/Sponsors.astro';
import Faq from '../components/home/Faq.astro';
import Booking from '../components/home/Booking.astro';
import { event } from '../data/event';
---

<Base
  description={`${event.name} ${event.year}: holdturnering, par 3 for nybegyndere, gallamiddag og auktion. ${event.dateLabel} på ${event.venue}.`}
  current="home"
>
  <Hero />
  <Stats />
  <Day />
  <Program />
  <Prices />
  <Purpose />
  <History />
  <Auction />
  <Sponsors />
  <Faq />
  <Booking />
</Base>
