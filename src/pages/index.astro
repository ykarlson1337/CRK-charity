---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Stats from '../components/home/Stats.astro';
import Day from '../components/home/Day.astro';
import Program from '../components/home/Program.astro';
import Prices from '../components/home/Prices.astro';
import Purpose from '../components/home/Purpose.astro';
import History from '../components/home/History.astro';
import Auction from '../components/home/Auction.astro';
import Sponsors from '../components/home/Sponsors.astro';
import Faq from '../components/home/Faq.astro';
import Booking from '../components/home/Booking.astro';
import { allPackages, event } from '../data/event';

const prices = allPackages.map((p) => p.price);
const description = `${event.name} ${event.year}: holdturnering, par 3 for nybegyndere, gallamiddag og auktion. ${event.dateLabel} på ${event.venue}.`;

// schema.org Event for search results. Times are local (CEST in June).
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: `${event.name} ${event.year}`,
  description,
  startDate: `${event.dateIso}T08:00:00+02:00`,
  endDate: `${event.dateIso}T23:00:00+02:00`,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  image: new URL('/og.jpg', Astro.site).href,
  location: {
    '@type': 'Place',
    name: event.venue,
    address: { '@type': 'PostalAddress', addressLocality: 'Smørum', addressCountry: 'DK' },
  },
  organizer: { '@type': 'Organization', name: event.club, url: Astro.site?.href },
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'DKK',
    lowPrice: Math.min(...prices),
    highPrice: Math.max(...prices),
    offerCount: prices.length,
    availability: 'https://schema.org/InStock',
    url: new URL('/#priser', Astro.site).href,
  },
};
---

<Base description={description} current="home">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <Hero />
  <Stats />
  <Day />
  <Program />
  <Prices />
  <Purpose />
  <History />
  <Auction />
  <Sponsors />
  <Faq />
  <Booking />
</Base>
